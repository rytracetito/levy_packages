t <- inspection_times("regular", n = 200, tmax = 400)$time
set.seed(1)
g <- rgamma(200, shape = diff(t) / 2, scale = 2)
x <- c(0, cumsum(0.5 * g + 1.5 * sqrt(g) * rnorm(200)))
vg_mle(x, t)
}
