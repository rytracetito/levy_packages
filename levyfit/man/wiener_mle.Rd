t <- inspection_times("increasing", n = 20, tmax = 50)$time
set.seed(1)
x <- c(0, cumsum(0.5 * diff(t) + 1.5 * sqrt(diff(t)) * rnorm(20)))
fit <- wiener_mle(x, t)
c(mu = fit$mu, sigma = fit$sigma)
fit$ci_mu
fit$ci_sigma
}
