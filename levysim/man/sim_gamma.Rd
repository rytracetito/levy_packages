\item \eqn{\Delta A_i = A(t_i) - A(t_{i-1})}, \eqn{i = 1, \dots, n}.
\item Draw independently \eqn{\Delta X_i \sim Ga(a \Delta A_i, b)}.
\item \eqn{X(t_0) = 0} and \eqn{X(t_i) = \sum_{j \le i} \Delta X_j}.
}
