plan <- DegradSim::inspection_times("decreasing", n = 20, n_traj = 10, tmax = 40)
x <- DegradSim::sim_vg(plan, theta = 0.5, sigma = 1.5, nu = 2)
est <- levyfit::vg_mle(x)
est
vg_bridge(0, 0, 2, 1, 1, theta = est, n = 3)
}
