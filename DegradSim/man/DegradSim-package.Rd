\title{DegradSim: simulation of Lévy and time-scaled Lévy degradation processes}
\description{
\code{DegradSim} simulates exactly, at given inspection times, one or several
degradation trajectories of two families of processes:
\enumerate{
\item \strong{Lévy processes}: gamma, Wiener, inverse Gaussian, variance-gamma,
Meixner, normal inverse Gaussian and compound Poisson processes;
\item \strong{time-scaled Lévy processes} \eqn{X_t = Y_{A(t)}}, where \eqn{Y} is a
Lévy process and \eqn{A} a time-scaling function: time-scaled gamma,
Wiener and inverse Gaussian processes.
}
}
\details{
The inspection times can be irregular and differ from one trajectory to
another; \code{\link[=inspection_times]{inspection_times()}} builds them with a chosen pattern. The
simulated trajectories can be printed, plotted and extracted as a data
frame.
}
\section{Lévy processes}{

\strong{Definition} (Sato, 2001, p. 3). A real stochastic process
\eqn{(X_t)_{t \ge 0}} is a Lévy process if
\enumerate{
\item it has independent increments: for all \eqn{n \ge 1} and
\eqn{0 \le t_0 < t_1 < \dots < t_n}, the random variables
\eqn{X_{t_0}, X_{t_1} - X_{t_0}, \dots, X_{t_n} - X_{t_{n-1}}} are
independent;
\item it starts at the origin: \eqn{X_0 = 0} almost surely;
\item it is time homogeneous: the distribution of
\eqn{(X_{s+t} - X_s)_{t \ge 0}} does not depend on \eqn{s};
\item it is stochastically continuous: for all \eqn{\varepsilon > 0},
\eqn{P(|X_{s+t} - X_s| > \varepsilon) \to 0} as \eqn{t \to 0};
\item its trajectories \eqn{t \mapsto X_t} are right-continuous with left
limits (càdlàg), almost surely.
}

\strong{Infinitely divisible distribution} (Sato, 2001, p. 4). A distribution
\eqn{\mu} on \eqn{\mathbb{R}} is infinitely divisible if, for every integer
\eqn{n \ge 1}, there is a distribution \eqn{\mu_n} such that
\eqn{\mu = \mu_n^{n*}}, the \eqn{n}-fold convolution of \eqn{\mu_n}: a
random variable with distribution \eqn{\mu} has the distribution of the sum
of \eqn{n} independent random variables with distribution \eqn{\mu_n}. For a
Lévy process, the distribution of \eqn{X_t} is infinitely divisible for
every \eqn{t}; conversely, every infinitely divisible distribution is the
distribution of \eqn{X_1} for a Lévy process, unique in law (Sato, 2001,
Theorems 1.1 and 1.2).

The simulation functions, with the distribution of an increment over a time
\eqn{\Delta t = t - s}:\tabular{llll}{
   Function \tab Process \tab Parameters \tab \eqn{X_t - X_s} \cr
   \code{\link[=sim_gamma]{sim_gamma()}} \tab gamma \tab \code{a}, \code{b} \tab \eqn{\Gamma(a \Delta t, b)} \cr
   \code{\link[=sim_wiener]{sim_wiener()}} \tab Wiener with drift \tab \code{mu}, \code{sigma} \tab \eqn{\mathcal{N}(\mu \Delta t, \sigma^2 \Delta t)} \cr
   \code{\link[=sim_ig]{sim_ig()}} \tab inverse Gaussian \tab \code{mu}, \code{eta} \tab \eqn{IG(\mu \Delta t, \eta \Delta t^2)} \cr
   \code{\link[=sim_vg]{sim_vg()}} \tab variance-gamma \tab \code{theta}, \code{sigma}, \code{nu} \tab \eqn{\theta G_{\Delta t} + \sigma B_{G_{\Delta t}}} \cr
   \code{\link[=sim_meixner]{sim_meixner()}} \tab Meixner \tab \code{a}, \code{b}, \code{d}, \code{m} \tab \eqn{Meixner(a, b, d \Delta t, m \Delta t)} \cr
   \code{\link[=sim_nig]{sim_nig()}} \tab normal inverse Gaussian \tab \code{alpha}, \code{beta}, \code{delta}, \code{mu} \tab \eqn{NIG(\alpha, \beta, \delta \Delta t, \mu \Delta t)} \cr
   \code{\link[=sim_cpoisson]{sim_cpoisson()}} \tab compound Poisson \tab \code{lambda}, \code{rjump} \tab sum of \eqn{Poisson(\lambda \Delta t)} jumps \cr
