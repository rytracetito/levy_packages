x <- sim_cpoisson(t8, lambda = 2, n_traj = 10)
dx <- traj_df(x, increments = TRUE)$dX
dx <- dx[!is.na(dx)]
c(zero_observed = mean(dx == 0), zero_theory = exp(-2))
dpos <- function(y) {
  vapply(y, function(v) sum(dpois(1:30, 2) * dgamma(v, 1:30, 1)), 0) / (1 - exp(-2))
}
